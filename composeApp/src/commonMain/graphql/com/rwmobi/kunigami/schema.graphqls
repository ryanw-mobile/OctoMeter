type SmartFlexChargingSession implements DeviceChargingSession {
  """
  The start time of a charging session.
  """
  start: DateTime!

  """
  The end time of a charging session.
  """
  end: DateTime!

  """
  The change in state of charge during a charging session. The value will be between 0 and 100, if not null.
  """
  stateOfChargeChange: Decimal

  """
  The final state of charge after a charging session. The value will be between 0 and 100, if not null.
  """
  stateOfChargeFinal: Decimal

  """
  The energy added during a charging session.
  """
  energyAdded: Energy

  """
  The cost for the charge added during a charging session.
  """
  cost: Money

  """
  The type of charge, i.e. `SMART` or `BOOST`.
  """
  type: SmartFlexChargingType!

  """
  The target type for a user's preferences.
  """
  targetType: PreferencesTargetType!

  """
  The charging session dispatch.
  """
  dispatches: [SmartFlexDispatch]

  """
  Charging problem(s) encountered during the session due to an error or truncation.
  """
  problems: [SmartFlexChargingProblem]
}

interface DeviceChargingSession {
  """
  The start time of a charging session.
  """
  start: DateTime!

  """
  The end time of a charging session.
  """
  end: DateTime!

  """
  The change in state of charge during a charging session. The value will be between 0 and 100, if not null.
  """
  stateOfChargeChange: Decimal

  """
  The final state of charge after a charging session. The value will be between 0 and 100, if not null.
  """
  stateOfChargeFinal: Decimal

  """
  The energy added during a charging session.
  """
  energyAdded: Energy

  """
  The cost for the charge added during a charging session.
  """
  cost: Money
}

"""
Describes the energy (not power) consumed (e.g. as electricity) or returned (e.g. as heat) by a
system over a given span of time.

Differs from `Power` in that it describes the *total* amount of energy transferred during a
given time frame (not a single point in time).
"""
type Energy {
  """
  The amount of energy (not power) transmitted.
  """
  value: Decimal

  """
  The units in which the energy is being measured.
  """
  unit: EnergyUnit!
}

"""
The energy unit.
"""
enum EnergyUnit {
  KILOWATT_HOUR
}

type Money {
  """
              The unit being in the smallest denomination of the currency (e.g. pence for GBP).
          
  """
  amount: Decimal!

  """
  The ISO-4217 code for the currency.
  """
  currency: String!
}

"""
The available charging types.
"""
enum SmartFlexChargingType {
  SMART

  BOOST

  TEST
}

"""
The target type for a user's preferences.
"""
enum PreferencesTargetType {
  ABSOLUTE_STATE_OF_CHARGE

  RELATIVE_STATE_OF_CHARGE

  ABSOLUTE_TEMPERATURE
}

type SmartFlexDispatch {
  """
  The start time of the dispatch.
  """
  start: DateTime!

  """
  The end time of the dispatch.
  """
  end: DateTime!

  """
  The type of charge.
  """
  type: SmartFlexChargingType!

  """
  The energy added in kWh of the dispatch.
  """
  energyAddedKwh: Decimal
}

union SmartFlexChargingProblem = SmartFlexChargingError|SmartFlexChargingTruncation

type SmartFlexChargingError {
  """
  Possible cause of the charging error.
  """
  cause: SmartFlexChargingErrorCause!
}

enum SmartFlexChargingErrorCause {
  """
  State of charge limit reached - Charging prevented due to a device specific charging limit setting (current state of charge is equal to or above the set limit).
  """
  SOC_LIMIT_REACHED

  """
  Unable to communicate with device - Dispatches were created but no telemetry readings available during the charge session.
  """
  COMMUNICATION_ERROR

  """
  Third-party charging interference - Telemetry for an at-home charging event was found outside of `Dispatch Schedules`.
  """
  THIRD_PARTY_CHARGING_INTERFERENCE

  """
  Observed power discrepancy - Power during the session was observed to be significantly different from the value of the max. import in static data.
  """
  POWER_DISCREPANCY

  """
  Observed power tapering - Power decreased at state of charge levels or towards the end of the session.
  """
  POWER_TAPERING

  """
  No scheduled charge within session - There were no schedules for the given charge session period.
  """
  NO_SCHEDULED_CHARGE

  """
  Unable to determine cause of failure -  If the charge session was not achieved, butwe are unable to determine the cause of failure.
  """
  FAILURE_CAUSE_ERROR

  """
  Action required - Customer needs to take action to re-enable our control (i.e attemptto re-onboard).
  """
  CUSTOMER_ACTION_REQUIRED

  """
  No charging - No charging (import of energy) was observed during the session.
  """
  NO_CHARGING

  """
  Device fully charged - Device conducting a relative charge session indicated it hadreached 100% SoC or an internal SoC limit. Applied regardless of whether or not wewere able to add the energy requested.
  """
  FULL_CHARGE

  """
  Post-charge battery drain - Target was hit but session ended below target due tobattery drain (caused e.g. by cell balancing).
  """
  POST_CHARGE_BATTERY_DRAIN

  """
  Unknown failure cause
  """
  UNKNOWN_CHARGING_ERROR_CAUSE
}

type SmartFlexChargingTruncation {
  """
  The cause for the truncation of a charging session.
  """
  truncationCause: SmartFlexChargingTruncationCause!

  """
  The state of charge (in percent) that could have been achieved, if not for truncation of the charging session.
  """
  originalAchievableStateOfCharge: Decimal!

  """
  The state of charge (in percent) that was possible, given the truncation.
  """
  achievableStateOfCharge: Decimal!
}

"""
The possible causes for a charging session ending prematurely.
"""
enum SmartFlexChargingTruncationCause {
  DISCONNECTED

  SUSPENDED

  BOOST_CHARGING

  UNKNOWN_TRUNCATION_CAUSE

  CHARGING_OPTIMISATION_CREATED

  DEVICE_DEAUTH_SUCCESS
}

