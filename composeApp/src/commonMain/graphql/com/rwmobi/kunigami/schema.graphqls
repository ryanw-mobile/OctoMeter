  BPAY

  BPOINT

  BRISTOL_POUND

  BTRE

  CASH

  CENTREPAY

  CHEQUE

  DESKTOP_DEPOSIT

  EAPA_VOUCHER

  EBOX

  EFT

  ERRONEOUS_PAYMENT

  FUEL_DIRECT

  HEEAS

  IVR

  MONEYGRAM

  PAYPAL

  SERVICE_TICKET

  SOCIAL_WELFARE_PAYMENT

  TELPAY

  TRANSFER_FROM_SAP

  URGS

  WALMART_CASH

  PAYPOINT_CASH

  PAYPOINT_CARD

  PAYPOINT_CHEQUE

  ALLPAY_CASH

  ALLPAY_CARD

