  EXPORT_MPAN_APPLIED_FOR

  """
  Export MPAN created.
  """
  EXPORT_MPAN_CREATED

  """
  Export Mpan Not Found.
  """
  EXPORT_MPAN_NOT_FOUND

  """
  MTDs updated.
  """
  MTD_UPDATED

  """
  Export Enabled In Kraken.
  """
  EXPORT_ENABLED_IN_KRAKEN

  """
  Export Meter Reading Available.
  """
  EXPORT_METER_READING_AVAILABLE

  """
