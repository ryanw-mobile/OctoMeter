  """
  The family name of the person making the referral.
  """
  referrerFamilyName: String @deprecated(reason: "The 'referrerFamilyName' field is deprecated.\n\nOnly make use of the referrerGivenName for privacy reasons.\n\n- Marked as deprecated on 2022-11-07.\n- Scheduled for removal on or after 2023-01-07.")

  """
  Scheme type of the referral scheme.
  """
  schemeType: String

  """
  Max number of times this referral code can be credited to a given account.
  """
  maxRecurrence: Int

  """
  True if the the scheme has limit of uses, and if the usage is at capacity.
  """
  isUsageAtCapacity: Boolean
}

