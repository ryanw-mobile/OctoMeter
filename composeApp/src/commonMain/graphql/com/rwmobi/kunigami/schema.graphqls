The device types that can be controlled by KrakenFlex.
"""
enum KrakenFlexDeviceTypes {
  BATTERIES

  ELECTRIC_VEHICLES

  INVERTERS

  HEAT_PUMPS

  STORAGE_HEATERS

  ELECTRICITY_METERS

  THERMOSTATS
}

"""
This refers to the provider that is used to authenticate when registering a device.
"""
enum ProviderChoices {
  BYD

  DAIKIN

  DAIKIN_LCM

  ECOBEE

  ECOBEE_V2

  ENERGIZER

  ENODE

  ENPHASE

  FORD

  GIVENERGY

  HUAWEI

  HUAWEI_V2

  HYPERVOLT

  INDRA

  JEDLIX

  JEDLIX_V2

  MERCEDES

