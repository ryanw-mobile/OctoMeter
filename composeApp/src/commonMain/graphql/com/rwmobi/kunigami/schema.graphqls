"""
Information about a vehicle that has been registered with Kraken Flex.
"""
type SmartFlexVehicle implements ElectricDevice & SmartFlexDeviceInterface {
  """
  A UUID that identifies this device registration. Re-registering this device will result in a different ID.
  """
  id: ID!

  """
  The user-friendly name for the device.
  """
  name: String

  """
  The type of device.
  """
  deviceType: KrakenFlexDeviceTypes!

  """
  The third-party that enables control of this device.
  """
  provider: ProviderChoices!

  """
  The third-party integration device ID.
  """
  integrationDeviceId: String

  """
  Information about the current status of this device.
  """
  status: SmartFlexDeviceStatusInterface!

  """
  The id of the property linked to the device.
  """
  propertyId: String

  """
  Active alert message(s) for a device, showing the latest first.
  """
  alerts: [SmartFlexDeviceAlertInterface]

  """
  The current onboarding wizard for a device.
  """
  onboardingWizard: SmartFlexOnboardingWizard

  """
  The device's preference details.
  """
  preferences: SmartFlexDevicePreferencesInterface

  """
  The preference setting for this device.
  """
  preferenceSetting: FlexDevicePreferenceSettingInterface

  """
  The re-authentication state of this device, if applicable.
  """
  reAuthenticationState: DeviceReAuthenticationInterface

  """
  History of charging sessions for a SmartFlex device.
  """
  chargingSessions("Latest time of the charging sessions i.e. end of the time window. Only sessions that start before this datetime are returned. Must be later than `after`." before: DateTime, "Earliest time of the charging sessions i.e. the start of the time window. Only sessions that start at or after this datetime are returned. Must be earlier than `before`." after: DateTime, "The types of charging sessions to be returned." sessionTypes: [ChargingSessionType], first: Int, last: Int): DeviceChargingSessionConnection

  """
  The make of the vehicle, e.g. Tesla.
  """
  make: String

  """
  The model of the vehicle, e.g. Model 3.
  """
  model: String

  """
  The battery capacity for the electric vehicle in kWh.
  """
  vehicleBatterySize: Decimal

  """
  The power output of the charge point in kW.
  """
  chargePointPowerOutput: Decimal

  """
  This contains more detail about the variant of the vehicle model.
  """
  vehicleVariant: ElectricVehicleModelType @deprecated(reason: "The 'vehicleVariant' field is deprecated.\n\nPlease use fields directly on 'SmartFlexVehicle' instead.\n\n- Marked as deprecated on 2026-04-15.\n- Scheduled for removal on or after 2026-10-15.")

  """
  This contains more detail about the variant of the charge point model.
  """
  chargePointVariant: ChargePointVariantModelType @deprecated(reason: "The 'chargePointVariant' field is deprecated.\n\nPlease use fields directly on 'SmartFlexVehicle' instead.\n\n- Marked as deprecated on 2026-04-15.\n- Scheduled for removal on or after 2026-10-15.")

  """
  The user's preferences for charging this vehicle.
  """
  chargingPreferences: SmartFlexVehicleChargingPreferences @deprecated(reason: "The 'chargingPreferences' field is deprecated.\n\nPlease use 'devices.preferences' instead.\n\n- Marked as deprecated on 2024-11-01.\n- Scheduled for removal on or after 2025-05-06.")
}

interface ElectricDevice {
  """
  History of charging sessions for a SmartFlex device.
  """
  chargingSessions("Latest time of the charging sessions i.e. end of the time window. Only sessions that start before this datetime are returned. Must be later than `after`." before: DateTime, "Earliest time of the charging sessions i.e. the start of the time window. Only sessions that start at or after this datetime are returned. Must be earlier than `before`." after: DateTime, "The types of charging sessions to be returned." sessionTypes: [ChargingSessionType], first: Int, last: Int): DeviceChargingSessionConnection
}

"""
Paginator for device charging session.
"""
