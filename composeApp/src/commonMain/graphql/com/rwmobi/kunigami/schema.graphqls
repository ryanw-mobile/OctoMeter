"""
Stable GraphQL API enum for payment failure reasons.

These values are decoupled from the domain FailureReason enum to maintain API stability.
Note: KRAKEN_ERROR is intentionally excluded as it's internal-only.
"""
enum FailureReason {
  PAYMENT_INSTRUCTION_NOT_USABLE

  PAYER_DECEASED

  INSUFFICIENT_FUNDS

  ACTION_REQUIRED

  CUSTOMER_OBJECTION

  INSTITUTIONAL_OBJECTION

  INVALID_AMOUNT

  SUSPICIOUS

  INSUFFICIENT_NOTICE

  PAST_DATE

  BAD_TIMING

  VENDOR_SYSTEM_MALFUNCTION

  UNKNOWN
}

