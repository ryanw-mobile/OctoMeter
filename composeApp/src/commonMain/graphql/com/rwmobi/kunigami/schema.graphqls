"""
Input type combining base supply point group fields with market-specific enrollment data (legacy).

Inherits address/property fields from BaseSupplyPointGroupInput and adds a single
`context` field whose type is a dynamically constructed InputObjectType containing
one field per configured market (morally a oneOf – callers should supply exactly one).
"""
input LegacyMarketDataInput {
  """
  The address where the supply points to be supplied are located.
  """
  addressDetails: LifecycleAddressInput = null

  """
  The ID of the property where the supply points are located.
  """
  property: ID

  """
  Market-specific enrollment details. Provide exactly one of the configured market input objects inside this container.
  """
  context: OneOfMarketEnrollmentInputType!
}

input LifecycleAddressInput {
  """
  Line 1 of address.
  """
  line1: String!

  """
  Postal code.
  """
  postalCode: String!

  """
  Country code.
  """
  countryCode: String

  """
  Line 2 of address.
  """
  line2: String = ""

  """
  Line 3 of address.
  """
  line3: String = ""

  """
  Line 4 of address.
  """
  line4: String = ""

  """
  Line 5 of address.
  """
  line5: String = ""
}

input OneOfMarketEnrollmentInputType {
  """
  Electricity enrollment details.
  """
  electricitySupplyPointData: ElectricityEnrollmentMarketInput = null

  """
  Gas enrollment details.
  """
  gasSupplyPointData: GasEnrollmentMarketInput = null

  """
  Simple Service enrollment details.
  """
  services: SimpleServicesEnrollmentMarketInput = null
}

"""
GBR Electricity enrollment market input supporting both quoted and product catalog journeys.

This is a fake union type - exactly one of quoted_supply_point_input or product_catalog_input must be provided.
"""
input ElectricityEnrollmentMarketInput {
  """
  Input for enrollment journeys where product details are provided via a quoted supply point.
  """
  quotedSupplyPointInput: ElectricityQuotedSupplyPointMarketInput

  """
  Input for enrollment journeys where product details are specified directly.
  """
  productCatalogInput: ElectricityProductCatalogMarketInput
}

"""
GBR Electricity enrollment market input for quoted supply points.

Note: external_identifier (inherited from QuotedMarketInput) should contain the MPAN.
"""
input ElectricityQuotedSupplyPointMarketInput {
  """
  The market supply point identification number.
  """
  externalIdentifier: String!

  """
  The requested supply start date for the supply point.
  """
  requestedSupplyStartDate: Date!

  """
  The id of the QuotedSupplyPoint created for the supply point.
  """
  quotedSupplyPointId: ID!

  """
  The import MPAN, used for export journeys where there is an associated import meter.
  """
  importMpan: String

  """
  Advanced parameters for meter point registration. Used for special cases and manual registrations.
  """
  advancedParams: AdvancedParamsInput
}

"""
Advanced parameters for electricity meter point registration.

These parameters provide fine-grained control over the registration process
and are typically used for manual registrations, special cases, or when
migrating from legacy systems.
"""
input AdvancedParamsInput {
  """
  Whether this is a change of tenancy.
  """
  isChangeOfTenancy: Boolean

  """
  Whether this is a non-domestic (business) meter point.
  """
  isNonDomestic: Boolean

  """
  Whether this is an export meter point.
  """
  isExport: Boolean

  """
  Whether the meter point is de-energised.
  """
  isDeenergised: Boolean

  """
  Whether this is an internal transfer.
  """
  isInternalTransfer: Boolean

  """
  Whether this meter point uses half-hourly settlement.
  """
  isHalfHourly: Boolean

  """
  Whether this is a new connection.
  """
  isNewConnection: Boolean

  """
  The profile class for the meter point.
  """
  profileClass: Int

  """
  The measurement class for the meter point.
  """
  measurementClass: MeasurementClass

  """
  The standard settlement configuration (SSC) code.
  """
  standardSettlementConfiguration: String

  """
  The meter timeswitch code (MTC).
  """
  meterTimeswitchCode: Int

  """
  The method used to retrieve meter readings.
  """
  retrievalMethod: RetrievalMethod

  """
  The reading cycle for the meter point.
  """
  readingCycle: RegularReadingCycle

  """
  The ID of the Meter Operator (MOP) contract.
  """
  mopContract: Int

  """
  The ID of the Data Aggregator (DA) contract.
  """
  daContract: Int

  """
  The ID of the Data Collector (DC) contract.
  """
  dcContract: Int

  """
  The ID of the Data Service contract (MHHS only).
  """
  dataServiceContract: Int

  """
  The ID of the Metering Service contract (MHHS only).
  """
  meteringServiceContract: Int

  """
  The consent granularity for reading data sharing (MHHS only).
  """
  consentGranularity: ConsentGranularityValue

  """
  The read frequency (MHHS only).
  """
  readFrequency: TraditionalFallBackReadFrequency

  """
  The Meter Data Retriever MPID (MHHS only).
  """
  mdrMpid: String

  """
  Whether to migrate this meter point to Market-wide Half Hourly Settlement (MHHS).
  """
  migrateToMhhs: Boolean
}

"""
The measurement class for the meter point.
"""
enum MeasurementClass {
  NHH_METERED

  NHH_UNMETERED

  HH_METERED_LARGE

  HH_UNMETERED

  HH_METERED_SMALL_CT

  HH_METERED_SMALL_DOM

  HH_METERED_SMALL_WC
}

"""
The method used to retrieve meter readings.
"""
enum RetrievalMethod {
  VISUAL

  MANUAL

  UNKNOWN

  REMOTE

  SMART

  UNMETERED
}

"""
The reading cycle for the meter point.
"""
enum RegularReadingCycle {
  ANNUAL

  BIMONTHLY

  DAILY

  EIGHTEEN_MONTHLY

  HALF_MONTHLY

  MONTHLY

  NO_READ_REQUIRED

  OTHER

  QUARTERLY

  SIX_MONTHLY

  TWENTY_EIGHT_DAYS

  WEEKLY

  TWENTY_FOUR_MONTHLY
}

"""
The read frequency (MHHS only).
"""
enum TraditionalFallBackReadFrequency {
  WEEKLY

  FORTNIGHTLY

  MONTHLY

  QUARTERLY

  SIX_MONTHLY

  ANNUALLY

  OBFUSCATED_VALUE
}

"""
GBR Electricity enrollment market input for product catalog journeys.

Note: external_identifier (inherited from ProductCatalogCharacteristicsInput) should contain the MPAN.
"""
